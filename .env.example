# ========================================================
# AI Research and Report Generator - Environment Configuration
# ========================================================

# Choose your LLM Provider and enter the appropriate API Key:

# Option 1: OpenAI (Default)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Option 2: Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# MODEL=gemini/gemini-1.5-flash

# Option 3: Groq (Ultra-fast inference)
# GROQ_API_KEY=your_groq_api_key_here
# MODEL=groq/llama-3.1-70b-versatile

# Option 4: Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# MODEL=anthropic/claude-3-5-sonnet-20241022

# Option 5: Local Ollama
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_MODEL_NAME=ollama/llama3

# Optional: Serper API for web search (if using real-time search tool)
# SERPER_API_KEY=your_serper_api_key_here

# CrewAI Settings
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true
